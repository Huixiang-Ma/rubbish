# 多 Agent 文旅系统 · 环境变量说明（.env 模板）
# 与 backend/app 源码 os.environ 散读点、docker-compose.yml 一一对应（2026-08-30 核对）
# 用法：复制为 .env 后按需修改；compose 会自动读取同名变量，本地裸跑可 source 或导出

# ---------- 队列 ----------
# 队列后端：memory（默认，本地零依赖）| redis（Docker 模式 compose 已内置）
QUEUE_BACKEND=memory
# Redis 连接（QUEUE_BACKEND=redis 时生效；compose 内为 redis://redis:6379/0）
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_STREAM=travel_plan_jobs
REDIS_GROUP=plan_workers
# REDIS_CONSUMER=worker-1  # 留空则按 主机+进程 自动生成，多副本扩容时避免同名互抢
# Streams XREAD BLOCK 毫秒数（默认 1000）
REDIS_BLOCK_MS=1000

# ---------- 数据目录 ----------
# 任务状态与产物根目录；默认 <项目根>/data/jobs；Docker 内为 /data/jobs（挂载宿主机 ./data）
# DATA_ROOT=data/jobs

# ---------- LLM（mock-first，全部可选） ----------
# real=调 OpenAI 兼容接口；mock=确定性模板（默认，断网可演示）
LLM_MODE=mock
# OpenAI 兼容端点，例：https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://ws-gpjpy8isjd5jzpoj.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=  # 例：sk-xxxxxxxx（真实密钥只填在 .env，勿提交模板）
# 按供应商选择，例：qwen-plus / deepseek-chat / gpt-4o-mini
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2

# ---------- docker compose 端口（仅 compose 读取） ----------
# 宿主机 6379/8000 被占用时不改文件直接换端口：REDIS_HOST_PORT=6391 BACKEND_HOST_PORT=8010
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8000

# ---- 生产演进（本次已实现，默认关闭/保守值） ----
# PostgreSQL 镜像层：设置后任务/审计/安全事件跨实例落库，并启用 pgvector 语义检索
# DATABASE_URL=postgresql+psycopg://wl:wl@postgres:5432/wl_travel  # 容器内用服务名 postgres，勿写 localhost
# 语义检索 Embedding：mock=确定性演示向量（默认，8 维零依赖）| ollama=宿主机 Ollama 的 BGE-M3
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_OLLAMA_URL=http://host.docker.internal:11434  # 容器内访问宿主机 Ollama
# EMBEDDING_MODEL=dengcao/bge-m3:567m
# EMBEDDING_DIM=1024
# EMBEDDING_TIMEOUT_SECONDS=10
# 多 Worker 数量（Redis 模式下配合分布式锁可多进程水平扩展）
WORKER_COUNT=1
# Prometheus 指标端点 /metrics 开关
METRICS_ENABLED=true
# 飞书群机器人审批提醒（未配置则静默跳过）
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# PEL 消息空闲多久可被 XAUTOCLAIM 认领（毫秒）；Worker 主循环重扫间隔（秒）
REDIS_CLAIM_MIN_IDLE_MS=60000
RECLAIM_INTERVAL_SECONDS=30

# ---- 统一 API 配置中心（backend/app/api_registry.py：同一能力只保留一个 API） ----
# 密钥就绪即自动启用，未填自动回退 mock 演示口径；复制本文件为 .env 后填写即生效
# （本地裸跑后端会自动向上查找项目根 .env 并加载；docker compose 原生读取）

# 【立即可用 2】高德开放平台：景点/餐饮 POI、路径规划、地理编码（免费注册 lbs.amap.com，免费额度够用）
AMAP_API_KEY=  # 在 lbs.amap.com 创建后填写

# 【立即可用 3】和风天气：实时天气与逐日预报（免费注册 dev.qweather.com）
QWEATHER_API_KEY=
# 和风专属 API Host（控制台-设置 查看，形如 https://xxx.re.qweatherapi.com/v7）：
# QWEATHER_API_HOST=https://xxx.re.qweatherapi.com/v7

# 【立即可用 4】飞猪AI开放平台（MCP 协议）：景点榜单/门票/飞猪预订链接/语义搜索
# 正式 API Key 获取：flyai.open.fliggy.com
FLIGGY_AI_API_KEY=
# MCP 端点默认 https://flyai.open.fliggy.com/mcp，一般无需覆盖：
# FLIGGY_AI_MCP_URL=https://flyai.open.fliggy.com/mcp
# ---- 携程问道（携程旅游大模型，OpenAI 兼容 chat/completions）----
# 密钥与网关地址以携程问道开放平台控制台为准（每租户分配专属域名，同和风模式）
CTRIP_WENDAO_API_KEY=
# 网关地址：填控制台分配的 OpenAI 兼容接入点（以 /v1 结尾），留空走默认占位（未配 key 时本就不启用）
# CTRIP_WENDAO_BASE_URL=https://wendao.ctrip.com/openai/v1
# 模型名：按开通文档填写（作生成备选 LLM 与行程问答）
CTRIP_WENDAO_MODEL=

# 【需入驻资质】飞猪开放平台（淘宝开放平台）：酒店查询/房价（taobao.xhotel.*）+ 门票商品（alitrip.ticket.*）
# 火车票/机票在该平台无搜索报价 API（仅代理商履约），行程书车次/航班保留演示口径并引导官方渠道
# TAOBAO_APP_KEY=
# TAOBAO_APP_SECRET=

# 【可选增强】阿里云内容安全（增强 Prompt 注入检测，默认正则已够演示）
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=

# ---- 外部能力扩展点（明确不接清单：本地 Mock 实现，配置 key 也不自动接） ----
EXTERNAL_MAP_PROVIDER=local
EXTERNAL_MAP_API_KEY=
EXTERNAL_SEARCH_PROVIDER=local
EXTERNAL_SEARCH_API_KEY=
EXTERNAL_OCR_PROVIDER=local
EXTERNAL_OCR_API_KEY=

# ---- 认证（演示级门禁：页面级登录 + HMAC token；true 时 toB 管理 API 强制校验） ----
AUTH_ENABLED=false
# 每账号/每 IP 每日免费规划单数（P2 成本治理，生产建议 3）
FREE_PLAN_PER_DAY=3
AUTH_SECRET=wl-dev-secret-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=wl2026  # 生产必改
# toC 演示账号与 toB 主管/顾问口令（生产必改，代码内不再持有固定口令）
TOB_CONSULTANT_PASSWORD=change-me
# toC 演示账号与 toB 主管/顾问口令（生产必改，代码内不再持有固定口令）
TOB_SUPERVISOR_PASSWORD=change-me
# toC 演示账号与 toB 主管/顾问口令（生产必改，代码内不再持有固定口令）
TOC_DEMO_PASSWORD=123456
# toC 演示账号与 toB 主管/顾问口令（生产必改，代码内不再持有固定口令）
TOC_DEMO_USERNAME=旅者
WEB_RESEARCH_ENABLED=false
